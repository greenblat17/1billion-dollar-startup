{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "compose-hot-reload": {
      "type": "local",
      "command": [
        "./gradlew",
        "--no-daemon",
        "--quiet",
        "--console=plain",
        ":app:desktopApp:hotMcpServer"
      ],
      "cwd": "cmp",
      "timeout": 180000
    },
    "klibs": {
      "type": "remote",
      "url": "https://api.klibs.io/mcp"
    }
  }
}
