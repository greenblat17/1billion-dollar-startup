# Two host files, not one. Catalog: ai_docs/integrations/2026-10-11-env.md
# CMP blob DEV_CMP_SERVER_ENV / PROD_CMP_SERVER_ENV → /opt/speaking-coach/.env
# AI blob DEV_AI_SERVER_ENV / PROD_AI_SERVER_ENV → /opt/ai-service/.env
# Leave secrets empty. A filled copy stays out of git.

# --- CMP: /opt/speaking-coach/.env ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
AI_SERVICE_BASE_URL=http://127.0.0.1:8090
AI_INTERNAL_TOKEN=
SERVER_PORT=8080
TLS_CERT_PATH=/opt/speaking-coach/tls.crt
TLS_KEY_PATH=/opt/speaking-coach/tls.key
JWT_SECRET=
DATABASE_URL=
POSTGRES_USER=speaking
POSTGRES_PASSWORD=
POSTGRES_DB=speaking_coach
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=
MONITORING_PORT=8081
# Redeploy overwrites this line from the GitHub secret of the same name.
METRICS_PASSWORD=
AUDIT_AUDIO_DIR=/opt/speaking-coach/audit-audio
SPEAKY_ENV=

# --- AI: /opt/ai-service/.env ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# OpenRouter key. The variable name is the OpenAI-compatible SDK name.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna
NOTES_MODEL=openai/gpt-5.6-luna
# Empty: review uses LLM_MODEL. Empty fallback retries that same model.
ONBOARDING_REVIEW_MODEL=
ONBOARDING_REVIEW_FALLBACK_MODEL=
TTS_PROVIDER=openrouter
# Code default below. Live hosts set x-ai/grok-voice-tts-1.0 instead.
TTS_MODEL=hexgrad/kokoro-82m
TTS_VOICE=af_heart
TTS_RESPONSE_FORMAT=mp3
TTS_OUTPUT_FORMAT=ogg
TTS_SPEED=0.9
DEEPGRAM_API_KEY=
FFMPEG_BIN=ffmpeg
# Empty keeps dialogue in process memory. Shape on the AI Docker network: redis://redis:6379/0
REDIS_URL=
AI_SERVICE_PORT=8090
# CMP WebRTC mint. Empty leaves the Telegram clip loop running.
OPENAI_REALTIME_API_KEY=
DIALOGUE_TTL_SECONDS=2592000
DIALOGUE_MAX_MESSAGES=40
JOB_TTL_SECONDS=600
PIPELINE_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
LOKI_PUSH_URL=
