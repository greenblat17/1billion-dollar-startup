{
  "steps": [
    {
      "name": "catalog",
      "request": {
        "kind": "catalog",
        "args": {
          "version": "speaky-v55-v2",
          "topicId": "grammar-a2-past-simple"
        }
      }
    },
    {
      "name": "state_before",
      "request": {
        "kind": "read",
        "resource": "state"
      }
    },
    {
      "name": "source",
      "request": {
        "kind": "source",
        "operationId": {
          "$uuid": true
        },
        "occurredAt": {
          "$now": true
        }
      }
    },
    {
      "name": "goal_update",
      "request": {
        "kind": "command",
        "operationId": {
          "$uuid": true
        },
        "action": "learning.update",
        "args": {
          "expectedRevision": {
            "$ref": "state_before.response.result.revision"
          },
          "patch": {
            "targetLevel": "B2"
          },
          "goal": "Synthetic Foundation contract acceptance: use Past Simple at work",
          "component": "foundation-acceptance-synthetic",
          "sources": {
            "$ref": "source.response.result.sources"
          }
        }
      }
    },
    {
      "name": "state_after",
      "request": {
        "kind": "read",
        "resource": "state"
      }
    },
    {
      "name": "task_create",
      "request": {
        "kind": "command",
        "operationId": {
          "$uuid": true
        },
        "action": "learning.task.create",
        "args": {
          "goalRevision": {
            "$ref": "state_after.response.result.revision"
          },
          "catalogVersion": {
            "$ref": "catalog.response.result.version"
          },
          "skillId": "grammar",
          "topicId": "grammar-a2-past-simple",
          "problemId": "grammar_application",
          "component": "foundation-acceptance-synthetic",
          "sources": {
            "$ref": "source.response.result.sources"
          },
          "reason": "Synthetic catalog-linked task contract check"
        }
      }
    },
    {
      "name": "plan_create",
      "request": {
        "kind": "command",
        "operationId": {
          "$uuid": true
        },
        "action": "learning.plan.create",
        "args": {
          "taskId": {
            "$ref": "task_create.response.result.task.id"
          },
          "expectedTaskRevision": {
            "$ref": "task_create.response.result.task.revision"
          },
          "definition": {
            "schemaVersion": 1,
            "stages": [
              {
                "id": "exercises",
                "method": "Exercises",
                "kind": "numeric",
                "required": true,
                "weight": 0.3
              },
              {
                "id": "conversation",
                "method": "Conversation",
                "kind": "numeric",
                "required": true,
                "weight": 0.7
              }
            ],
            "order": [
              "exercises",
              "conversation"
            ],
            "transitions": [
              {
                "from": "exercises",
                "to": "conversation"
              },
              {
                "from": "conversation",
                "to": "exercises"
              }
            ]
          },
          "component": "foundation-acceptance-synthetic",
          "currentStageId": "exercises"
        }
      }
    },
    {
      "name": "score_before",
      "request": {
        "kind": "read",
        "resource": "score",
        "resourceId": {
          "$ref": "task_create.response.result.task.id"
        }
      }
    },
    {
      "name": "observation_record",
      "request": {
        "kind": "command",
        "operationId": {
          "$uuid": true
        },
        "action": "learning.observation.record",
        "args": {
          "observation": {
            "schemaVersion": 1,
            "attemptId": {
              "$uuid": true
            },
            "evidenceSlot": "synthetic-assessment-only-1",
            "anchorEventId": {
              "$ref": "source.response.result.sourceEventId"
            },
            "lessonId": null,
            "occurredAt": {
              "$now": true
            },
            "sources": [
              {
                "eventId": {
                  "$ref": "source.response.result.sourceEventId"
                },
                "revision": {
                  "$ref": "source.response.result.sourceSequence"
                },
                "role": "user",
                "purpose": "answer",
                "span": {
                  "start": 0,
                  "end": 4
                }
              }
            ],
            "catalogVersion": {
              "$ref": "catalog.response.result.version"
            },
            "skillId": "grammar",
            "topicId": "grammar-a2-past-simple",
            "problemId": "grammar_application",
            "practice": "homework",
            "method": "exercises",
            "kind": "demonstration",
            "outcome": "independent_correct",
            "support": "independent",
            "initialOutcome": "correct",
            "quality": {
              "status": "usable",
              "signals": [],
              "confidence": null
            },
            "provenance": {
              "component": "foundation-acceptance-synthetic",
              "analyzerVersion": "fixture-v1"
            },
            "taskId": {
              "$ref": "task_create.response.result.task.id"
            },
            "stageRef": {
              "planId": {
                "$ref": "plan_create.response.result.plan.id"
              },
              "planRevision": {
                "$ref": "plan_create.response.result.plan.revision"
              },
              "stageId": "exercises",
              "stageAttemptId": null
            },
            "actionId": null,
            "repeatOf": null,
            "route": "assessment_only",
            "rationale": "Synthetic usable route contract fixture; no real learner claim."
          }
        }
      }
    },
    {
      "name": "observation_read",
      "request": {
        "kind": "read",
        "resource": "observation",
        "resourceId": {
          "$ref": "observation_record.response.result.observation.id"
        }
      }
    },
    {
      "name": "observation_replay",
      "request": {
        "$ref": "observation_record.request"
      }
    },
    {
      "name": "score_after",
      "request": {
        "kind": "read",
        "resource": "score",
        "resourceId": {
          "$ref": "task_create.response.result.task.id"
        }
      }
    },
    {
      "name": "state_after_observation",
      "request": {
        "kind": "read",
        "resource": "state"
      }
    },
    {
      "name": "observations",
      "request": {
        "kind": "read",
        "resource": "observations"
      }
    }
  ]
}
