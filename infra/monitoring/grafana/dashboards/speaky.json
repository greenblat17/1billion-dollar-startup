{
  "title": "Speaky",
  "uid": "speaky-v2",
  "schemaVersion": 39,
  "timezone": "Europe/Moscow",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Списано, USD",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 6}, "overrides": []},
      "targets": [{"expr": "speaking_cost_micro{client=\"telegram\"} / 1000000", "legendFormat": "{{currency}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Токены чата",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "speaking_prompt_tokens{client=\"telegram\"}", "legendFormat": "prompt", "refId": "A"},
        {"expr": "speaking_completion_tokens{client=\"telegram\"}", "legendFormat": "completion", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Токены звонка",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "speaking_realtime_tokens{client=\"telegram\"}", "legendFormat": "{{part}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Объём",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "speaking_stt_seconds{client=\"telegram\"}", "legendFormat": "stt s", "refId": "A"},
        {"expr": "speaking_tts_chars{client=\"telegram\"}", "legendFormat": "tts chars", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "DAU и ходы",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "speaking_dau{client=\"telegram\"}", "legendFormat": "dau", "refId": "A"},
        {"expr": "speaking_turns{client=\"telegram\"}", "legendFormat": "turns", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Частота",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "speaking_actions{client=\"telegram\"}", "legendFormat": "{{action}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Ошибки сервисов",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [{"expr": "speaking_errors{client=\"telegram\"} or on() label_replace(speaking_dau{client=\"telegram\"} * 0, \"outcome\", \"нет ошибок\", \"client\", \"telegram\")", "legendFormat": "{{outcome}}", "refId": "A"}]
    }
  ]
}
