{
  "title": "Speaky",
  "uid": "speaky-v2",
  "schemaVersion": 39,
  "timezone": "Europe/Moscow",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Доступность",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "state-timeline",
      "title": "Доступность cmp-service и ai-service",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "min_over_time(probe_success{job=\"blackbox-ktor\"}[$__interval])",
          "legendFormat": "Сервис telegram-бота (cmp-service)",
          "refId": "A"
        },
        {
          "expr": "min_over_time(probe_success{job=\"blackbox-ai\"}[$__interval])",
          "legendFormat": "AI-сервис (ai-service)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "нет",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "доступен",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Проверка /health каждые 15 с. Шаг красный, если хотя бы одна проверка в нём не прошла.",
      "id": 2
    },
    {
      "type": "stat",
      "title": "Метрики получены",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "timestamp(last_over_time((up{job=\"speaking-telegram\"} == 1)[24h:])) * 1000",
          "legendFormat": "cmp-service",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "timestamp(last_over_time((up{job=\"speaking-v2\"} == 1)[24h:])) * 1000",
          "legendFormat": "ai-service",
          "instant": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "noValue": "нет за сутки",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      },
      "description": "Время последнего успешного сбора за сутки. Оба сервиса опрашиваются каждые 15 с.",
      "id": 3
